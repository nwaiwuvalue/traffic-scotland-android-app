<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="@color/blue_primary"
        app:titleTextColor="@color/white" />

    <ProgressBar
        android:id="@+id/loadingIndicator"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/offlineBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2E7D32"
        android:gravity="center"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:text="● Online • Refreshing..."
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="visible" />

    <!-- Main Landscape Body -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left Pane: List / Search / Map -->
        <FrameLayout
            android:id="@+id/mainContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.15" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#DCE4EC" />

        <!-- Middle Pane: Detail View -->
        <FrameLayout
            android:id="@+id/detailContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#DCE4EC" />

        <!-- Right Edge: Slim, Evenly Spaced Navigation Rail -->
        <com.google.android.material.navigationrail.NavigationRailView
            android:id="@+id/bottomNavigation"
            android:layout_width="68dp"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            app:elevation="0dp"
            app:itemActiveIndicatorStyle="@null"
            app:itemIconTint="@color/nav_item_color"
            app:itemPaddingBottom="14dp"
            app:itemPaddingTop="14dp"
            app:itemTextColor="@color/nav_item_color"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav_menu"
            app:menuGravity="center" />
    </LinearLayout>

</LinearLayout>